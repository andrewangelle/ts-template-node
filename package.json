{
  "name": "ts-template-node",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "author": "andrewangelle@gmail.com",
  "license": "MIT",
  "main": "src/index.mts",
  "type": "module",
  "imports": {
    "#root/*": "./src/*"
  },
  "scripts": {
    "start": "node ./src/index.mts",
    "lint:fix": "pnpx biome check . --write",
    "lint:check": "pnpx biome check .",
    "format": "pnpx biome format . --write",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm lint:fix",
      "pnpm format"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
